import java.util.Scanner;

public class Converter {

    // Conversion Methods
    public static double convertKilometersToMiles(double kilometers) {
        return kilometers * 0.62;
    }

    public static double convertMilesToKilometers(double miles) {
        return miles * 1.61;
    }

    public static double convertCelsiusToFahrenheit(double celsius) {
        return (celsius * 9 / 5) + 32;
    }

    public static double convertFahrenheitToCelsius(double fahrenheit) {
        return (fahrenheit - 32) * 5 / 9;
    }

    public static double convertUSDollarsToPhilippinePesos(double usDollars) {
        return usDollars * 56.21;
    }

    public static double convertPhilippinePesosToUSDollars(double philippinePesos) {
        return philippinePesos / 56.21;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int choice;

        do {
            System.out.println("1. Kilometers to Miles");
            System.out.println("2. Miles to Kilometers");
            System.out.println("3. Celsius to Fahrenheit");
            System.out.println("4. Fahrenheit to Celsius");
            System.out.println("5. USD to Philippine Pesos");
            System.out.println("6. Philippine Pesos to USD");
            System.out.println("7. Exit");
            System.out.print("Enter your choice: ");
            choice = scanner.nextInt();

            switch (choice) {
                case 1:
                    System.out.print("Enter kilometers: ");
                    double km = scanner.nextDouble();
                    System.out.println(km + " kilometers = " + convertKilometersToMiles(km) + " miles");
                    break;
                case 2:
                    System.out.print("Enter miles: ");
                    double mi = scanner.nextDouble();
                    System.out.println(mi + " miles = " + convertMilesToKilometers(mi) + " kilometers");
                    break;
                case 3:
                    System.out.print("Enter Celsius: ");
                    double c = scanner.nextDouble();
                    System.out.println(c + " Celsius = " + convertCelsiusToFahrenheit(c) + " Fahrenheit");
                    break;
                case 4:
                    System.out.print("Enter Fahrenheit: ");
                    double f = scanner.nextDouble();
                    System.out.println(f + " Fahrenheit = " + convertFahrenheitToCelsius(f) + " Celsius");
                    break;
                case 5:
                    System.out.print("Enter USD: ");
                    double usd = scanner.nextDouble();
                    System.out.println(usd + " USD = " + convertUSDollarsToPhilippinePesos(usd) + " Pesos");
                    break;
                case 6:
                    System.out.print("Enter Philippine Pesos: ");
                    double pesos = scanner.nextDouble();
                    System.out.println(pesos + " Pesos = " + convertPhilippinePesosToUSDollars(pesos) + " USD");
                    break;
                case 7:
                    System.out.println("Exiting the program...");
                    break;
                default:
                    System.out.println("Invalid choice, please try again.");
            }

        } while (choice != 7);

        scanner.close();
    }
}

